DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=YOUR_ELASTIC_IP
CORS_ALLOWED_ORIGINS=https://YOUR_VERCEL_DOMAIN
CSRF_TRUSTED_ORIGINS=https://YOUR_VERCEL_DOMAIN
SECURE_SSL_REDIRECT=false
DEV_ALLOW_ANONYMOUS=false
TOKEN_TTL_HOURS=24
DATA_UPLOAD_MAX_MEMORY_SIZE=20971520

DB_ENGINE=mysql
DB_NAME=the_we
DB_USER=thewe_admin
DB_PASSWORD=replace-with-your-rds-password
DB_HOST=replace-with-your-rds-endpoint
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_SSL_CA=/etc/ssl/certs/aws-rds-global-bundle.pem

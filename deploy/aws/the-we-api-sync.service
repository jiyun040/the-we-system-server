[Unit]
Description=Synchronize The We sales records from PDAM
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/the-we-system-server
EnvironmentFile=/home/ubuntu/the-we-system-server/.env
ExecStart=/home/ubuntu/the-we-system-server/.venv/bin/python manage.py sync_pdam_sales

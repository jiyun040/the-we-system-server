DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CSRF_TRUSTED_ORIGINS=
DEV_ALLOW_ANONYMOUS=true
DEV_DEFAULT_USERNAME=edu_manager
TOKEN_TTL_HOURS=168
DATA_UPLOAD_MAX_MEMORY_SIZE=20971520

# 로컬 기본값은 SQLite입니다. AWS에서는 mysql로 변경합니다.
DB_ENGINE=sqlite
DATABASE_PATH=db.sqlite3
DB_NAME=the_we_test
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
DB_CONN_MAX_AGE=60

# PDAM is queried directly through a separate read-only MySQL connection.
# Copy these values to .env and set PDAM_DB_PASSWORD locally; never commit it.
PDAM_DB_NAME=wooritech
PDAM_DB_USER=root
PDAM_DB_PASSWORD=
PDAM_DB_HOST=139.150.75.233
PDAM_DB_PORT=3306
PDAM_SALES_QUERY=SELECT d.id AS source_id, COALESCE(NULLIF(c.location, ''), NULLIF(g.groupName, ''), NULLIF(c.name, ''), CONCAT('현장-', d.id)) AS project_name, COALESCE(g.groupName, '') AS contractor, COALESCE(c.name, '') AS partner, COALESCE(NULLIF(d.machineNumber, ''), d.lavelNo) AS elevator, d.startDate AS start_date, r.record_date AS record_date, d.endDate AS end_date, CASE WHEN d.conduct = 1 THEN '종료' ELSE '진행' END AS status, CASE WHEN d.conduct = 2 THEN '가맹' WHEN d.conduct = 0 THEN '본사' ELSE '' END AS category, COALESCE(d.isDel, 0) AS is_deleted FROM TB_DEVICE d LEFT JOIN TB_CONSTRUCTION c ON c.id = d.constructionIdx LEFT JOIN TB_GROUP g ON g.idx = c.groupIdx LEFT JOIN (SELECT deviceIdx, MIN(currentDateTime) AS record_date FROM TB_REPORT GROUP BY deviceIdx) r ON r.deviceIdx = d.id
DB_SSL_CA=
